APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Basis data: MySQL / MariaDB (driver yang dipakai aplikasi) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_pu
DB_USERNAME=absensi
DB_PASSWORD=

# --- Alternatif tanpa server basis data: SQLite ---
# Tukar ke dua baris di bawah bila ingin menjalankan tanpa MySQL.
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/ke/app/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Disk untuk berkas unggahan (lihat config/filesystems.php -> 'uploads').
#   public_disk  : berkas yang boleh dibuka lewat URL langsung (foto profil).
#   private_disk : berkas privat, hanya disajikan lewat route ber-otorisasi
#                  (dokumen surat tugas perjalanan dinas).
# Untuk produksi dengan object storage, isi keduanya dengan 's3'.
UPLOAD_PUBLIC_DISK=public
UPLOAD_PRIVATE_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Endpoint S3-compatible (mis. Neva Objects). Wajib diisi bila bukan AWS asli,
# dan AWS_USE_PATH_STYLE_ENDPOINT harus true.
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
