@startuml 01-login-admin
!theme plain
title Login Admin — Super Admin dan Admin Wilayah

' ── Skinparam global (kompak dan rapi) ────────────────────────
skinparam DefaultFontName "Inter"
skinparam DefaultFontSize 11
skinparam Padding 4
skinparam RoundCorner 6
skinparam Shadowing false
skinparam ArrowColor #334155
skinparam ArrowThickness 1.2
skinparam ArrowFontColor #64748B
skinparam ArrowFontSize 10

' ── Activity ─────────────────────────────────────────────────
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #334155
skinparam ActivityBorderThickness 1.2
skinparam ActivityFontColor #0F172A
skinparam ActivityDiamondBackgroundColor #FEF3C7
skinparam ActivityDiamondBorderColor #F59E0B
skinparam ActivityDiamondBorderThickness 1.2
skinparam ActivityDiamondFontColor #92400E

' ── Partition swimlane ───────────────────────────────────────
skinparam PartitionBackgroundColor #F8FAFC
skinparam PartitionBorderColor #1E3A8A
skinparam PartitionBorderThickness 1.5
skinparam PartitionFontStyle bold
skinparam PartitionFontColor #1E3A8A
skinparam PartitionFontSize 12

' ── Start/End ────────────────────────────────────────────────
skinparam ActivityStartColor #0F172A
skinparam ActivityEndColor #0F172A

|ADMIN|
start
:Buka halaman login;
:Isi email dan sandi;
:Klik Masuk;

|SISTEM|
if (Input kosong?) then (ya)
  #FEE2E2:Tampilkan error
  Email atau sandi salah;
  |ADMIN|
  :Perbaiki input;
  stop
else (tidak)
endif

|SISTEM|
:Cari user by email
(is_active = true);

if (Kredensial cocok?) then (tidak)
  #FEE2E2:Tampilkan error
  Email atau sandi salah;
  |ADMIN|
  :Perbaiki input;
  stop
else (ya)
endif

|SISTEM|
:Regenerate session;

if (Role sesuai area?) then (tidak)
  :Logout paksa;
  #FEE2E2:Tampilkan error
  Tidak ada akses;
  |ADMIN|
  :Perbaiki input;
  stop
else (ya)
  :Redirect ke area;
  #DCFCE7:Dashboard Admin
  siap digunakan;
  stop
endif

@enduml
