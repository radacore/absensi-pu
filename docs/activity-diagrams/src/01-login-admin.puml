@startuml 01-login-admin
!theme plain
title Login Admin — Super Admin dan Admin Wilayah

' ── Skinparam ────────────────────────────────────────────────
skinparam DefaultFontName "Inter"
skinparam DefaultFontSize 11
skinparam Padding 6
skinparam RoundCorner 8
skinparam Shadowing false
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 10
skinparam ArrowFontStyle bold

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #334155
  BorderThickness 1.3
  FontColor #0F172A
}

' ── Node types via stereotype ────────────────────────────────
skinparam rectangle<<start>> {
  BackgroundColor #0F172A
  BorderColor #0F172A
  FontColor #FFFFFF
  FontStyle bold
}
skinparam rectangle<<end>> {
  BackgroundColor #0F172A
  BorderColor #0F172A
  FontColor #FFFFFF
  FontStyle bold
}
skinparam rectangle<<user>> {
  BackgroundColor #EFF6FF
  BorderColor #1E3A8A
  FontColor #1E3A8A
}
skinparam rectangle<<sys>> {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}
skinparam rectangle<<decision>> {
  BackgroundColor #FEF3C7
  BorderColor #F59E0B
  FontColor #92400E
  FontStyle bold
}
skinparam rectangle<<error>> {
  BackgroundColor #FEE2E2
  BorderColor #EF4444
  FontColor #991B1B
  FontStyle bold
}
skinparam rectangle<<success>> {
  BackgroundColor #DCFCE7
  BorderColor #10B981
  FontColor #065F46
  FontStyle bold
}

' ── Nodes ────────────────────────────────────────────────────
rectangle "MULAI" as START <<start>>

rectangle "1. Buka halaman login\n/super-admin/login atau /admin/login" as A1 <<user>>
rectangle "2. Isi email dan kata sandi" as A2 <<user>>
rectangle "3. Klik tombol Masuk" as A3 <<user>>

rectangle "4. Validasi input:\nemail dan password wajib" as S1 <<sys>>
rectangle "Input\nkosong?" as D1 <<decision>>

rectangle "5. Query users\nWHERE email = ? AND is_active = true" as S2 <<sys>>
rectangle "User\nditemukan\ndan sandi\ncocok?" as D2 <<decision>>

rectangle "6. Auth::guard(web)->login(user)\nSession::regenerate()" as S3 <<sys>>
rectangle "Role user\nsesuai area\nyang diakses?" as D3 <<decision>>

rectangle "7a. Auth::guard(web)->logout()\nHapus session" as S4 <<sys>>
rectangle "7b. Redirect ke area sesuai role\n/super-admin atau /admin" as S5 <<sys>>

rectangle "ERROR:\nEmail atau kata sandi salah" as E1 <<error>>
rectangle "ERROR:\nAkun tidak memiliki akses area ini" as E2 <<error>>

rectangle "SUKSES:\nDashboard Admin tampil dengan\nsidebar dan aktivitas terbaru" as OK <<success>>

rectangle "SELESAI" as END <<end>>

' ── Flow (top-down) ──────────────────────────────────────────
START -down-> A1
A1 -down-> A2
A2 -down-> A3
A3 -down-> S1
S1 -down-> D1

D1 -right-> E1 : ya
D1 -down-> S2 : tidak

S2 -down-> D2
D2 -right-> E1 : tidak
D2 -down-> S3 : ya

S3 -down-> D3
D3 -right-> S4 : tidak
S4 -down-> E2

D3 -down-> S5 : ya
S5 -down-> OK
OK -down-> END

E1 -down-> A2 : ulangi input
E2 -down-> A2 : ulangi input

@enduml
